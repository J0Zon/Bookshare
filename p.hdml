<!-- หน้าแรก BookShare (Home) - Complete Earth Tone Minimal Design -->
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>BookShare - ร้านหนังสือ &amp; เช่ายืมออนไลน์</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&family=Mali:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'earth-bg': '#F5EFE6',
            'earth-card': '#FFFFFF',
            'earth-primary': '#6B4F4F',
            'earth-primary-hover': '#523838',
            'earth-secondary': '#E8D8C4',
            'earth-accent': '#BC6C25',
            'earth-sage': '#A3B18A',
            'earth-sage-dark': '#3A4D39',
            'earth-text': '#3D312A',
            'earth-muted': '#8D7B68',
            'earth-border': '#E5D9CCC4'
          },
          fontFamily: {
            'cute': ['Mali', 'cursive'],
            'body': ['Kanit', 'sans-serif']
          }
        }
      }
    };
  </script>
  <style>
    body {
      font-family: 'Kanit', sans-serif;
      background-color: #F5EFE6;
      color: #3D312A;
    }
    h1, h2, h3, .font-cute {
      font-family: 'Mali', cursive;
    }
    ::-webkit-scrollbar { display: none; }
  </style>
</head>
<body class="bg-earth-bg text-earth-text antialiased">

  <!-- Header Navigation -->
  <header class="fixed top-0 w-full z-40 bg-earth-bg/90 backdrop-blur-md border-b border-earth-border shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">
      <!-- Logo & Search -->
      <div class="flex items-center gap-6">
        <a href="#" class="flex items-center gap-2">
          <span class="material-symbols-outlined text-3xl text-earth-accent">menu_book</span>
          <div class="flex flex-col leading-none">
            <span class="font-cute text-2xl font-bold text-earth-primary">BookShare</span>
            <span class="text-xs text-earth-muted">เช่า &amp; ซื้อขายหนังสือ</span>
          </div>
        </a>
        <div class="relative hidden md:block w-72">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-earth-muted text-lg">search</span>
          <input type="search" placeholder="ค้นหาหนังสือ, ผู้แต่ง, ผู้ขาย..." class="w-full pl-9 pr-4 py-2 bg-white/80 rounded-full text-sm border border-earth-border focus:outline-none focus:ring-2 focus:ring-earth-accent transition"/>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="hidden lg:flex items-center gap-6 font-medium text-sm">
        <a href="#browse-books" class="text-earth-primary font-bold hover:text-earth-accent transition">สำรวจหนังสือ</a>
        <a href="#how-it-works" class="text-earth-muted hover:text-earth-primary transition">วิธีการเช่า-คืน</a>
        <a href="#seller-section" class="text-earth-muted hover:text-earth-primary transition">ตั้งร้านค้าขาย/ให้เช่า</a>
      </nav>

      <!-- Cart & Profile -->
      <div class="flex items-center gap-3">
        <!-- ยืม Cart -->
        <button onclick="openModal('cart-modal')" class="relative p-2 rounded-full bg-earth-sage/20 text-earth-sage-dark hover:bg-earth-sage/30 transition flex items-center gap-1 px-3">
          <span class="material-symbols-outlined text-xl">auto_stories</span>
          <span class="text-xs font-bold">ยืม (2)</span>
        </button>
        <!-- ซื้อ Cart -->
        <button onclick="openModal('cart-modal')" class="relative p-2 rounded-full bg-earth-accent/15 text-earth-accent hover:bg-earth-accent/25 transition flex items-center gap-1 px-3">
          <span class="material-symbols-outlined text-xl">shopping_bag</span>
          <span class="text-xs font-bold">ซื้อ (1)</span>
        </button>
        
        <!-- User Profile -->
        <div class="flex items-center gap-2 pl-2 border-l border-earth-border">
          <div class="w-9 h-9 rounded-full bg-earth-secondary flex items-center justify-center font-cute font-bold text-earth-primary">
            M
          </div>
          <div class="hidden sm:flex flex-col text-left">
            <span class="text-xs font-bold leading-tight">คุณมีนา</span>
            <span class="text-[10px] text-earth-sage-dark font-medium">สมาชิกนักอ่าน</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="pt-24 pb-16 max-w-7xl mx-auto px-4 sm:px-6">

    <!-- Hero Banner -->
    <section class="bg-earth-secondary/40 rounded-3xl p-6 sm:p-10 mb-12 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-xl space-y-4">
        <span class="inline-block px-3 py-1 bg-earth-sage/30 text-earth-sage-dark rounded-full text-xs font-bold tracking-wide">
          🌱 ชุมชนแบ่งปันหนังสือยั่งยืน
        </span>
        <h1 class="text-3xl sm:text-4xl font-bold text-earth-primary leading-tight">
          ส่งต่อเรื่องราวดีๆ <br/>
          <span class="text-earth-accent">อ่านเพลินไม่ต้องซื้อขาด</span> <br/>
          หรือเปิดร้านสร้างรายได้
        </h1>
        <p class="text-earth-muted text-sm sm:text-base">
          เช่ายืมหนังสือเล่มโปรดเริ่มต้นเพียง <b>฿5 /วัน</b> พร้อมหน้าต่างปฏิทินเลือกว่าจะคืนวันไหนได้ตามใจคุณ
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#browse-books" class="px-6 py-3 rounded-2xl bg-earth-primary text-white font-bold text-sm hover:bg-earth-primary-hover shadow-sm transition">
            เริ่มสำรวจหนังสือ
          </a>
          <a href="#seller-section" class="px-6 py-3 rounded-2xl bg-white text-earth-primary font-bold text-sm hover:bg-earth-secondary/50 shadow-sm transition">
            ตั้งร้านค้าของคุณ
          </a>
        </div>
      </div>
      <div class="w-full md:w-80 h-52 bg-earth-secondary/80 rounded-2xl flex flex-col justify-center items-center p-6 text-center shadow-inner">
        <span class="material-symbols-outlined text-5xl text-earth-accent mb-2">calendar_month</span>
        <h3 class="font-bold text-lg text-earth-primary">ระบบปฏิทินยืม-คืน</h3>
        <p class="text-xs text-earth-muted mt-1">คำนวณราคายืมตามจำนวนวันจริง คืนง่าย ส่งกลับสะดวก</p>
      </div>
    </section>

    <!-- Category Filters -->
    <section id="browse-books" class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-earth-primary flex items-center gap-2">
          <span class="material-symbols-outlined text-earth-accent">auto_stories</span>
          หนังสือทั้งหมดในคลัง
        </h2>
        <div class="flex gap-2 text-xs">
          <button class="px-3 py-1.5 rounded-full bg-earth-primary text-white font-medium">ทั้งหมด</button>
          <button class="px-3 py-1.5 rounded-full bg-white text-earth-muted hover:bg-earth-secondary/50 transition">จิตวิทยา &amp; พัฒนาตนเอง</button>
          <button class="px-3 py-1.5 rounded-full bg-white text-earth-muted hover:bg-earth-secondary/50 transition">วรรณกรรม &amp; นิยาย</button>
          <button class="px-3 py-1.5 rounded-full bg-white text-earth-muted hover:bg-earth-secondary/50 transition">ธุรกิจ &amp; การลงทุน</button>
        </div>
      </div>

      <!-- Book Grid (8 Items) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Book 1: Atomic Habits (พร้อมยืม/ซื้อ) -->
        <div class="bg-white rounded-2xl p-4 shadow-sm hover:shadow-md transition flex flex-col justify-between border border-earth-border">
          <div>
            <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden bg-earth-bg mb-3">
              <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80" alt="Atomic Habits" class="w-full h-full object-cover"/>
              <span class="absolute top-2 left-2 px-2.5 py-1 rounded-full bg-earth-sage text-white text-[11px] font-bold shadow-sm">
                🟢 พร้อมให้ยืม
              </span>
            </div>
            <span class="text-xs text-earth-muted font-medium">จิตวิทยา &amp; พัฒนาตนเอง</span>
            <h3 class="font-bold text-earth-text line-clamp-1 hover:text-earth-primary transition">Atomic Habits (เพราะหยดน้ำทำให้แก้วเต็ม)</h3>
            <p class="text-xs text-earth-muted mb-2">James Clear</p>
          </div>
          <div class="pt-2 border-t border-earth-border/60 flex items-center justify-between">
            <div>
              <span class="text-xs text-earth-muted block">ยืม ฿7/วัน</span>
              <span class="text-sm font-bold text-earth-primary">ซื้อขาด ฿280</span>
            </div>
            <button onclick="openRentModal('Atomic Habits', 7)" class="p-2.5 rounded-xl bg-earth-primary text-white hover:bg-earth-primary-hover transition" title="เลือกระยะเวลายืม">
              <span class="material-symbols-outlined text-lg">calendar_month</span>
            </button>
          </div>
        </div>

        <!-- Book 2: Miracle of Namiya (ถูกยืมอยู่) -->
        <div class="bg-white rounded-2xl p-4 shadow-sm hover:shadow-md transition flex flex-col justify-between border border-earth-border opacity-90">
          <div>
            <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden bg-earth-bg mb-3">
              <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=600&q=80" alt="ปาฏิหาริย์ร้านชำของคุณนามิยะ" class="w-full h-full object-cover"/>
              <span class="absolute top-2 left-2 px-2.5 py-1 rounded-full bg-red-400 text-white text-[11px] font-bold shadow-sm">
                🔴 ถูกยืมอยู่
              </span>
            </div>
            <span class="text-xs text-earth-muted font-medium">วรรณกรรมแปล</span>
            <h3 class="font-bold text-earth-text line-clamp-1">ปาฏิหาริย์ร้านชำของคุณนามิยะ</h3>
            <p class="text-xs text-earth-muted mb-2">ฮิงาชิโนะ เคโงะ</p>
          </div>
          <div class="pt-2 border-t border-earth-border/60 flex items-center justify-between">
            <div>
              <span class="text-xs text-earth-muted block">ว่างประมาณ 28 ต.ค.</span>
              <span class="text-sm font-bold text-earth-primary">ซื้อขาด ฿245</span>
            </div>
            <button class="p-2.5 rounded-xl bg-earth-secondary text-earth-muted cursor-not-allowed" disabled title="ขณะนี้ยังไม่พร้อมให้ยืม">
              <span class="material-symbols-outlined text-lg">block</span>
            </button>
          </div>
        </div>

        <!-- Book 3: Psychology of Money (สำหรับขายเท่านั้น) -->
        <div class="bg-white rounded-2xl p-4 shadow-sm hover:shadow-md transition flex flex-col justify-between border border-earth-border">
          <div>
            <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden bg-earth-bg mb-3">
              <img src="https://images.unsplash.com/photo-1592496431122-2349e0fbc666?auto=format&fit=crop&w=600&q=80" alt="Psychology of Money" class="w-full h-full object-cover"/>
              <span class="absolute top-2 left-2 px-2.5 py-1 rounded-full bg-earth-accent text-white text-[11px] font-bold shadow-sm">
                🏷️ สำหรับขายเท่านั้น
              </span>
            </div>
            <span class="text-xs text-earth-muted font-medium">การเงิน &amp; การลงทุน</span>
            <h3 class="font-bold text-earth-text line-clamp-1">The Psychology of Money</h3>
            <p class="text-xs text-earth-muted mb-2">Morgan Housel</p>
          </div>
          <div class="pt-2 border-t border-earth-border/60 flex items-center justify-between">
            <div>
              <span class="text-xs text-earth-muted line-through">฿290</span>
              <span class="text-sm font-bold text-earth-accent block">฿230 (มือสอง 98%)</span>
            </div>
            <button class="p-2.5 rounded-xl bg-earth-accent text-white hover:bg-amber-700 transition" title="ใส่ตะกร้าซื้อ">
              <span class="material-symbols-outlined text-lg">shopping_cart</span>
            </button>
          </div>
        </div>

        <!-- Book 4: คิดแบบยิว (พร้อมยืม) -->
        <div class="bg-white rounded-2xl p-4 shadow-sm hover:shadow-md transition flex flex-col justify-between border border-earth-border">
          <div>
            <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden bg-earth-bg mb-3">
              <img src="https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=600&q=80" alt="คิดแบบยิว ทำแบบญี่ปุ่น" class="w-full h-full object-cover"/>
              <span class="absolute top-2 left-2 px-2.5 py-1 rounded-full bg-earth-sage text-white text-[11px] font-bold shadow-sm">
                🟢 พร้อมให้ยืม
              </span>
            </div>
            <span class="text-xs text-earth-muted font-medium">ธุรกิจ &amp; ปรัชญา</span>
            <h3 class="font-bold text-earth-text line-clamp-1">คิดแบบยิว ทำแบบญี่ปุ่น</h3>
            <p class="text-xs text-earth-muted mb-2">ฮอนดะ เคน</p>
          </div>
          <div class="pt-2 border-t border-earth-border/60 flex items-center justify-between">
            <div>
              <span class="text-xs text-earth-muted block">ยืม ฿5/วัน</span>
              <span class="text-sm font-bold text-earth-primary">ซื้อขาด ฿190</span>
            </div>
            <button onclick="openRentModal('คิดแบบยิว ทำแบบญี่ปุ่น', 5)" class="p-2.5 rounded-xl bg-earth-primary text-white hover:bg-earth-primary-hover transition">
              <span class="material-symbols-outlined text-lg">calendar_month</span>
            </button>
          </div>
        </div>

        <!-- Book 5: กล้าที่จะถูกเกลียด -->
        <div class="bg-white rounded-2xl p-4 shadow-sm hover:shadow-md transition flex flex-col justify-between border border-earth-border">
          <div>
            <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden bg-earth-bg mb-3">
              <img src="https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=600&q=80" alt="กล้าที่จะถูกเกลียด" class="w-full h-full object-cover"/>
              <span class="absolute top-2 left-2 px-2.5 py-1 rounded-full bg-earth-sage text-white text-[11px] font-bold shadow-sm">
                🟢 พร้อมให้ยืม
              </span>
            </div>
            <span class="text-xs text-earth-muted font-medium">จิตวิทยา</span>
            <h3 class="font-bold text-earth-text line-clamp-1">กล้าที่จะถูกเกลียด</h3>
            <p class="text-xs text-earth-muted mb-2">อิจิโร คิชิมิ</p>
          </div>
          <div class="pt-2 border-t border-earth-border/60 flex items-center justify-between">
            <div>
              <span class="text-xs text-earth-muted block">ยืม ฿6/วัน</span>
              <span class="text-sm font-bold text-earth-primary">ซื้อขาด ฿220</span>
            </div>
            <button onclick="openRentModal('กล้าที่จะถูกเกลียด', 6)" class="p-2.5 rounded-xl bg-earth-primary text-white hover:bg-earth-primary-hover transition">
              <span class="material-symbols-outlined text-lg">calendar_month</span>
            </button>
          </div>
        </div>

        <!-- Book 6: แมวโชคดี -->
        <div class="bg-white rounded-2xl p-4 shadow-sm hover:shadow-md transition flex flex-col justify-between border border-earth-border">
          <div>
            <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden bg-earth-bg mb-3">
              <img src="https://images.unsplash.com/photo-1532012197267-da84d127e765?auto=format&fit=crop&w=600&q=80" alt="แมวหมอดู" class="w-full h-full object-cover"/>
              <span class="absolute top-2 left-2 px-2.5 py-1 rounded-full bg-earth-sage text-white text-[11px] font-bold shadow-sm">
                🟢 พร้อมให้ยืม
              </span>
            </div>
            <span class="text-xs text-earth-muted font-medium">วรรณกรรมฮีลใจ</span>
            <h3 class="font-bold text-earth-text line-clamp-1">คุณหมอดูแมวชี้ชะตา</h3>
            <p class="text-xs text-earth-muted mb-2">ผู้เขียนญี่ปุ่น</p>
          </div>
          <div class="pt-2 border-t border-earth-border/60 flex items-center justify-between">
            <div>
              <span class="text-xs text-earth-muted block">ยืม ฿5/วัน</span>
              <span class="text-sm font-bold text-earth-primary">ซื้อขาด ฿200</span>
            </div>
            <button onclick="openRentModal('คุณหมอดูแมวชี้ชะตา', 5)" class="p-2.5 rounded-xl bg-earth-primary text-white hover:bg-earth-primary-hover transition">
              <span class="material-symbols-outlined text-lg">calendar_month</span>
            </button>
          </div>
        </div>

        <!-- Book 7: Sapiens -->
        <div class="bg-white rounded-2xl p-4 shadow-sm hover:shadow-md transition flex flex-col justify-between border border-earth-border">
          <div>
            <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden bg-earth-bg mb-3">
              <img src="https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=600&q=80" alt="Sapiens" class="w-full h-full object-cover"/>
              <span class="absolute top-2 left-2 px-2.5 py-1 rounded-full bg-earth-accent text-white text-[11px] font-bold shadow-sm">
                🏷️ สำหรับขายเท่านั้น
              </span>
            </div>
            <span class="text-xs text-earth-muted font-medium">ประวัติศาสตร์</span>
            <h3 class="font-bold text-earth-text line-clamp-1">Sapiens: เซเปียนส์ ประวัติศาสตร์มนุษยชาติ</h3>
            <p class="text-xs text-earth-muted mb-2">Yuval Noah Harari</p>
          </div>
          <div class="pt-2 border-t border-earth-border/60 flex items-center justify-between">
            <div>
              <span class="text-xs text-earth-muted line-through">฿530</span>
              <span class="text-sm font-bold text-earth-accent block">฿390</span>
            </div>
            <button class="p-2.5 rounded-xl bg-earth-accent text-white hover:bg-amber-700 transition">
              <span class="material-symbols-outlined text-lg">shopping_cart</span>
            </button>
          </div>
        </div>

        <!-- Book 8: Deep Work -->
        <div class="bg-white rounded-2xl p-4 shadow-sm hover:shadow-md transition flex flex-col justify-between border border-earth-border">
          <div>
            <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden bg-earth-bg mb-3">
              <img src="https://images.unsplash.com/photo-1476275466078-4007374efbbe?auto=format&fit=crop&w=600&q=80" alt="Deep Work" class="w-full h-full object-cover"/>
              <span class="absolute top-2 left-2 px-2.5 py-1 rounded-full bg-earth-sage text-white text-[11px] font-bold shadow-sm">
                🟢 พร้อมให้ยืม
              </span>
            </div>
            <span class="text-xs text-earth-muted font-medium">การทำงาน</span>
            <h3 class="font-bold text-earth-text line-clamp-1">Deep Work: สมาธิดิ่งลึก</h3>
            <p class="text-xs text-earth-muted mb-2">Cal Newport</p>
          </div>
          <div class="pt-2 border-t border-earth-border/60 flex items-center justify-between">
            <div>
              <span class="text-xs text-earth-muted block">ยืม ฿6/วัน</span>
              <span class="text-sm font-bold text-earth-primary">ซื้อขาด ฿250</span>
            </div>
            <button onclick="openRentModal('Deep Work: สมาธิดิ่งลึก', 6)" class="p-2.5 rounded-xl bg-earth-primary text-white hover:bg-earth-primary-hover transition">
              <span class="material-symbols-outlined text-lg">calendar_month</span>
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- Seller Section: ระบบตั้งร้านสำหรับผู้ขาย -->
    <section id="seller-section" class="my-16 bg-white rounded-3xl p-6 sm:p-10 border border-earth-border shadow-sm">
      <div class="max-w-3xl mx-auto text-center space-y-3 mb-8">
        <span class="px-3 py-1 bg-earth-secondary text-earth-primary rounded-full text-xs font-bold">
          🏪 มุมผู้ขาย &amp; เจ้าของหนังสือ
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-earth-primary">เปลี่ยนตู้หนังสือบ้านคุณให้เป็นรายได้</h2>
        <p class="text-earth-muted text-sm">
          เปิดร้านง่ายๆ ในหน้าบัญชีของคุณ กำหนดราคาขาย หรือราคาเช่าต่อวันได้เองตามต้องการ
        </p>
      </div>

      <!-- Add Book Form Simulation -->
      <div class="max-w-2xl mx-auto bg-earth-bg rounded-2xl p-6 border border-earth-border">
        <h3 class="font-bold text-earth-primary text-lg mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-earth-accent">add_box</span>
          ลงทะเบียนหนังสือเพื่อเช่า/ขาย
        </h3>
        <form onsubmit="event.preventDefault(); alert('บันทึกข้อมูลหนังสือเรียบร้อยแล้ว!');" class="space-y-4 text-sm">
          <div>
            <label class="block font-medium mb-1">ชื่อหนังสือ</label>
            <input type="text" placeholder="ระบุชื่อหนังสือ..." class="w-full p-2.5 rounded-xl bg-white border border-earth-border focus:outline-none focus:ring-1 focus:ring-earth-primary" required/>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-medium mb-1">หมวดหมู่</label>
              <select class="w-full p-2.5 rounded-xl bg-white border border-earth-border focus:outline-none focus:ring-1 focus:ring-earth-primary">
                <option>จิตวิทยา &amp; พัฒนาตนเอง</option>
                <option>วรรณกรรม &amp; นิยายแปล</option>
                <option>ธุรกิจ &amp; การลงทุน</option>
                <option>หนังสือเด็ก/การ์ตูน</option>
              </select>
            </div>
            <div>
              <label class="block font-medium mb-1">สภาพหนังสือ (%)</label>
              <input type="number" placeholder="เช่น 90%" min="50" max="100" class="w-full p-2.5 rounded-xl bg-white border border-earth-border focus:outline-none focus:ring-1 focus:ring-earth-primary"/>
            </div>
          </div>
          <div>
            <label class="block font-medium mb-1">รูปแบบการลงขาย</label>
            <div class="flex gap-4">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="sale_type" checked class="accent-earth-primary"/> ให้เช่ายืม &amp; ขายขาด
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="sale_type" class="accent-earth-primary"/> ให้เช่ายืมอย่างเดียว
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="sale_type" class="accent-earth-primary"/> ขายขาดอย่างเดียว
              </label>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block font-medium mb-1">ค่ายืมต่อวัน (บาท)</label>
              <input type="number" placeholder="เช่น 5" class="w-full p-2.5 rounded-xl bg-white border border-earth-border focus:outline-none focus:ring-1 focus:ring-earth-primary"/>
            </div>
            <div>
              <label class="block font-medium mb-1">ราคาขายขาด (บาท)</label>
              <input type="number" placeholder="เช่น 200" class="w-full p-2.5 rounded-xl bg-white border border-earth-border focus:outline-none focus:ring-1 focus:ring-earth-primary"/>
            </div>
          </div>
          <button type="submit" class="w-full py-3 bg-earth-primary text-white rounded-xl font-bold hover:bg-earth-primary-hover transition mt-2">
            บันทึกหนังสือเข้าสู่ร้านค้า
          </button>
        </form>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="bg-earth-secondary/30 border-t border-earth-border py-8 text-center text-xs text-earth-muted">
    <div class="max-w-7xl mx-auto px-4">
      <p class="font-cute text-sm text-earth-primary font-bold mb-1">BookShare Thailand</p>
      <p>เว็บไซต์ยืมและซื้อขายหนังสือออนไลน์ สำหรับทุกคนที่รักการอ่าน</p>
    </div>
  </footer>

  <!-- Modal 1: ปฏิทินเลือกระยะเวลายืม (Rental Calendar Modal) -->
  <div id="rent-modal" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl p-6 max-w-md w-full border border-earth-border shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-earth-border pb-3">
        <h3 id="modal-book-title" class="font-bold text-earth-primary text-lg">เลือกระยะเวลายืม</h3>
        <button onclick="closeModal('rent-modal')" class="text-earth-muted hover:text-earth-primary">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      
      <div class="space-y-3">
        <div>
          <label class="block text-xs text-earth-muted mb-1">วันเริ่มยืม</label>
          <input type="date" id="start-date" class="w-full p-2.5 rounded-xl bg-earth-bg border border-earth-border text-sm" onchange="calculateRental()"/>
        </div>
        <div>
          <label class="block text-xs text-earth-muted mb-1">วันที่กำหนดคืน (เลือกในปฏิทิน)</label>
          <input type="date" id="end-date" class="w-full p-2.5 rounded-xl bg-earth-bg border border-earth-border text-sm" onchange="calculateRental()"/>
        </div>
        
        <!-- Summary calculation box -->
        <div class="bg-earth-bg p-4 rounded-2xl space-y-1 text-sm border border-earth-border">
          <div class="flex justify-between">
            <span class="text-earth-muted">จำนวนวันที่ยืม:</span>
            <span id="rental-days" class="font-bold">1 วัน</span>
          </div>
          <div class="flex justify-between">
            <span class="text-earth-muted">อัตราค่ายืม:</span>
            <span id="rate-per-day" class="font-bold">฿0 / วัน</span>
          </div>
          <div class="flex justify-between border-t border-earth-border/60 pt-2 text-earth-primary font-bold">
            <span>ราคายืมรวมทั้งสิ้น:</span>
            <span id="total-price" class="text-lg text-earth-accent">฿0</span>
          </div>
        </div>
      </div>

      <button onclick="alert('เพิ่มหนังสือในตะกร้ายืมเรียบร้อยแล้ว!'); closeModal('rent-modal');" class="w-full py-3 bg-earth-primary text-white font-bold rounded-xl hover:bg-earth-primary-hover transition">
        ยืนยันใส่ตะกร้ายืม
      </button>
    </div>
  </div>

  <!-- Modal 2: ตะกร้าสินค้าและการจัดส่ง (Cart & Checkout Modal) -->
  <div id="cart-modal" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl p-6 max-w-lg w-full border border-earth-border shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-earth-border pb-3">
        <h3 class="font-bold text-earth-primary text-lg">ตะกร้าของคุณ &amp; ข้อมูลจัดส่ง</h3>
        <button onclick="closeModal('cart-modal')" class="text-earth-muted hover:text-earth-primary">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <!-- Cart Items -->
      <div class="space-y-3">
        <div class="p-3 bg-earth-bg rounded-xl flex items-center justify-between text-sm">
          <div>
            <span class="text-xs bg-earth-sage text-white px-2 py-0.5 rounded-full font-bold">ยืม 7 วัน</span>
            <p class="font-bold text-earth-primary mt-1">Atomic Habits</p>
            <p class="text-xs text-earth-muted">กำหนดคืน: 30 ต.ค. 2026</p>
          </div>
          <span class="font-bold text-earth-accent">฿49</span>
        </div>
        <div class="p-3 bg-earth-bg rounded-xl flex items-center justify-between text-sm">
          <div>
            <span class="text-xs bg-earth-accent text-white px-2 py-0.5 rounded-full font-bold">ซื้อขาด</span>
            <p class="font-bold text-earth-primary mt-1">The Psychology of Money</p>
          </div>
          <span class="font-bold text-earth-accent">฿230</span>
        </div>
      </div>

      <!-- Shipping Form -->
      <div class="border-t border-earth-border pt-4 space-y-3 text-xs">
        <h4 class="font-bold text-earth-primary text-sm">ข้อมูลที่อยู่สำหรับจัดส่ง</h4>
        <input type="text" placeholder="ชื่อ-นามสกุล ผู้รับ" class="w-full p-2.5 rounded-xl bg-earth-bg border border-earth-border" value="คุณมีนา รักการอ่าน"/>
        <input type="tel" placeholder="เบอร์โทรศัพท์" class="w-full p-2.5 rounded-xl bg-earth-bg border border-earth-border" value="081-234-5678"/>
        <textarea placeholder="ที่อยู่จัดส่งโดยละเอียด..." class="w-full p-2.5 rounded-xl bg-earth-bg border border-earth-border" rows="2">123/45 ถนนมิตรภาพ อ.เมือง จ.พิษณุโลก 65000</textarea>
      </div>

      <div class="border-t border-earth-border pt-3 flex justify-between items-center font-bold">
        <span>ยอดชำระรวมทั้งหมด:</span>
        <span class="text-xl text-earth-accent">฿279</span>
      </div>

      <button onclick="alert('ดำเนินการชำระเงินเรียบร้อยแล้ว! ระบบกำลังเตรียมการจัดส่ง'); closeModal('cart-modal');" class="w-full py-3 bg-earth-primary text-white font-bold rounded-xl hover:bg-earth-primary-hover transition">
        ดำเนินการชำระเงิน / ยืนยันการยืม
      </button>
    </div>
  </div>

  <!-- JavaScript for Modals and Rental Calculation -->
  <script>
    let currentRate = 0;

    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }

    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    function openRentModal(title, rate) {
      document.getElementById('modal-book-title').innerText = 'ยืมหนังสือ: ' + title;
      currentRate = rate;
      document.getElementById('rate-per-day').innerText = '฿' + rate + ' / วัน';
      
      // Set default dates (Today & +7 Days)
      const today = new Date();
      const nextWeek = new Date();
      nextWeek.setDate(today.getDate() + 7);

      document.getElementById('start-date').value = today.toISOString().split('T')[0];
      document.getElementById('end-date').value = nextWeek.toISOString().split('T')[0];

      calculateRental();
      openModal('rent-modal');
    }

    function calculateRental() {
      const start = new Date(document.getElementById('start-date').value);
      const end = new Date(document.getElementById('end-date').value);

      if (end >= start) {
        const diffTime = Math.abs(end - start);
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) || 1;
        document.getElementById('rental-days').innerText = diffDays + ' วัน';
        document.getElementById('total-price').innerText = '฿' + (diffDays * currentRate);
      } else {
        document.getElementById('rental-days').innerText = 'ระบุวันที่ไม่ถูกต้อง';
        document.getElementById('total-price').innerText = '฿0';
      }
    }
  </script>

</body>
</html>